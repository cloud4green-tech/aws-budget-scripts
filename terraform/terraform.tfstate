          "schema_version": 0,
          "attributes": {
            "administration_role_arn": null,
            "arn": "arn:aws:cloudformation:us-east-1:969356183753:stackset/c4g-budget-guardian-member-baseline:013479a0-d593-4ca2-ac7d-99a12681566e",
            "auto_deployment": [
              {
                "depends_on_stack_sets": [],
                "enabled": true,
                "retain_stacks_on_account_removal": false
              }
            ],
            "call_as": "SELF",
            "capabilities": [
              "CAPABILITY_NAMED_IAM"
            ],
            "description": "",
            "execution_role_name": "stacksets-exec-ab917da36cafb88f14ffbb21c743ea1d",
            "id": "c4g-budget-guardian-member-baseline",
            "managed_execution": [
              {
                "active": false
              }
            ],
            "name": "c4g-budget-guardian-member-baseline",
            "operation_preferences": [
              {
                "failure_tolerance_count": 0,
                "failure_tolerance_percentage": 10,
                "max_concurrent_count": 0,
                "max_concurrent_percentage": 25,
                "region_concurrency_type": "",
                "region_order": []
              }
            ],
            "parameters": {
              "CentralEventBusArn": "arn:aws:events:us-east-1:969356183753:event-bus/c4g-budget-guardian-central",
              "CentralLambdaRoleArn": "arn:aws:iam::969356183753:role/c4g-budget-guardian-lambda-role",
              "ExternalId": "****",
              "MemberRoleName": "C4GBudgetMemberRole"
            },
            "permission_model": "SERVICE_MANAGED",
            "region": "us-east-1",
            "stack_set_id": "c4g-budget-guardian-member-baseline:013479a0-d593-4ca2-ac7d-99a12681566e",
            "tags": {},
            "tags_all": {},
            "template_body": "AWSTemplateFormatVersion: '2010-09-09'\nDescription: Cloud4Green member account baseline for threshold-based budget guardian.\nParameters:\n  CentralLambdaRoleArn:\n    Type: String\n  CentralEventBusArn:\n    Type: String\n  ExternalId:\n    Type: String\n    NoEcho: true\n  MemberRoleName:\n    Type: String\n    Default: C4GBudgetMemberRole\nResources:\n  BudgetMemberRole:\n    Type: AWS::IAM::Role\n    Properties:\n      RoleName: !Ref MemberRoleName\n      AssumeRolePolicyDocument:\n        Version: '2012-10-17'\n        Statement:\n          - Effect: Allow\n            Principal:\n              AWS: !Ref CentralLambdaRoleArn\n            Action: sts:AssumeRole\n            Condition:\n              StringEquals:\n                sts:ExternalId: !Ref ExternalId\n      Policies:\n        - PolicyName: SafeStopOnlyNoDelete\n          PolicyDocument:\n            Version: '2012-10-17'\n            Statement:\n              - Sid: EC2StopOnly\n                Effect: Allow\n                Action: [ec2:DescribeRegions, ec2:DescribeInstances, ec2:StopInstances, ec2:DescribeVolumes]\n                Resource: '*'\n              - Sid: SageMakerStopOnly\n                Effect: Allow\n                Action: [sagemaker:ListNotebookInstances, sagemaker:StopNotebookInstance, sagemaker:ListTrainingJobs, sagemaker:DescribeTrainingJob, sagemaker:StopTrainingJob, sagemaker:ListEndpoints, sagemaker:DescribeEndpoint, sagemaker:DescribeEndpointConfig]\n                Resource: '*'\n              - Sid: LambdaThrottleOnly\n                Effect: Allow\n                Action: [lambda:ListFunctions, lambda:PutFunctionConcurrency, lambda:ListEventSourceMappings, lambda:UpdateEventSourceMapping]\n                Resource: '*'\n              - Sid: ECSScaleStopOnly\n                Effect: Allow\n                Action: [ecs:ListClusters, ecs:ListServices, ecs:DescribeServices, ecs:UpdateService, ecs:ListTasks, ecs:StopTask, ecs:DescribeTasks]\n                Resource: '*'\n              - Sid: EKSScaleNodegroupsOnly\n                Effect: Allow\n                Action: [eks:ListClusters, eks:DescribeCluster, eks:ListNodegroups, eks:DescribeNodegroup, eks:UpdateNodegroupConfig]\n                Resource: '*'\n              - Sid: GlueStopOnly\n                Effect: Allow\n                Action: [glue:GetJobs, glue:GetJobRuns, glue:BatchStopJobRun]\n                Resource: '*'\n              - Sid: EMRReadAndServerlessStopOnly\n                Effect: Allow\n                Action: [elasticmapreduce:ListClusters, elasticmapreduce:DescribeCluster, emr-serverless:ListApplications, emr-serverless:StopApplication]\n                Resource: '*'\n              - Sid: ExplicitDenyDangerousDeletes\n                Effect: Deny\n                Action:\n                  - ec2:TerminateInstances\n                  - sagemaker:DeleteEndpoint\n                  - sagemaker:DeleteModel\n                  - sagemaker:DeleteNotebookInstance\n                  - sagemaker:DeleteTrainingJob\n                  - lambda:DeleteFunction\n                  - ecs:DeleteService\n                  - eks:DeleteCluster\n                  - eks:DeleteNodegroup\n                  - s3:DeleteObject\n                  - s3:DeleteBucket\n                  - dynamodb:DeleteTable\n                  - dynamodb:DeleteItem\n                Resource: '*'\n  ForwardRole:\n    Type: AWS::IAM::Role\n    Properties:\n      RoleName: C4GBudgetEventForwardRole\n      AssumeRolePolicyDocument:\n        Version: '2012-10-17'\n        Statement:\n          - Effect: Allow\n            Principal: { Service: events.amazonaws.com }\n            Action: sts:AssumeRole\n      Policies:\n        - PolicyName: PutToCentralBus\n          PolicyDocument:\n            Version: '2012-10-17'\n            Statement:\n              - Effect: Allow\n                Action: events:PutEvents\n                Resource: !Ref CentralEventBusArn\n  ForwardCloudTrailEvents:\n    Type: AWS::Events::Rule\n    Properties:\n      Name: C4GBudgetForwardCloudTrailEvents\n      State: ENABLED\n      EventPattern:\n        detail-type: [\"AWS API Call via CloudTrail\"]\n        detail:\n          eventSource:\n            - ec2.amazonaws.com\n            - sagemaker.amazonaws.com\n            - lambda.amazonaws.com\n            - ecs.amazonaws.com\n            - eks.amazonaws.com\n            - glue.amazonaws.com\n            - elasticmapreduce.amazonaws.com\n            - s3.amazonaws.com\n            - dynamodb.amazonaws.com\n            - bedrock.amazonaws.com\n            - bedrock-runtime.amazonaws.com\n            - bedrock-agent.amazonaws.com\n            - bedrock-agent-runtime.amazonaws.com\n            - bedrock-agentcore.amazonaws.com\n      Targets:\n        - Id: CentralBus\n          Arn: !Ref CentralEventBusArn\n          RoleArn: !GetAtt ForwardRole.Arn\nOutputs:\n  BudgetMemberRoleArn:\n    Value: !GetAtt BudgetMemberRole.Arn\n  ForwardRuleArn:\n    Value: !GetAtt ForwardCloudTrailEvents.Arn\n",
            "template_url": null,
            "timeouts": null
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsidXBkYXRlIjoxODAwMDAwMDAwMDAwfX0=",
          "dependencies": [
            "aws_cloudwatch_event_bus.central",
            "aws_iam_role.lambda",
            "data.aws_caller_identity.current",
            "data.aws_iam_policy_document.lambda_assume",
            "random_id.suffix"
          ]
        }
      ]
    },
